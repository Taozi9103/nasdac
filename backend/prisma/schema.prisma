generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolios    Portfolio[]
  strategies    Strategy[]
  watchlists    Watchlist[]
}

model Asset {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String
  createdAt DateTime @default(now())

  prices     AssetPrice[]
  portfolioAssets PortfolioAsset[]
  watchlistItems  WatchlistItem[]
}

model AssetPrice {
  id        String   @id @default(uuid())
  assetId   String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  adjClose  Float?
  createdAt DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id])

  @@unique([assetId, date])
  @@index([assetId])
  @@index([date])
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  assets       PortfolioAsset[]
  correlations Correlation[]
}

model PortfolioAsset {
  id          String   @id @default(uuid())
  portfolioId String
  assetId     String
  weight      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id])

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
}

model Correlation {
  id           String   @id @default(uuid())
  portfolioId  String
  asset1Id    String
  asset2Id    String
  coefficient  Float
  period       String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())

  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@unique([portfolioId, asset1Id, asset2Id, period])
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  rules       String
  parameters  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  backtests Backtest[]
}

model Backtest {
  id          String   @id @default(uuid())
  strategyId  String
  startDate   DateTime
  endDate     DateTime
  initialCash Float
  finalValue  Float
  returnRate  Float
  sharpeRatio Float?
  maxDrawdown Float?
  winRate     Float?
  results     String?
  trades      String?
  createdAt   DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  items  WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(uuid())
  watchlistId String
  assetId     String
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset      @relation(fields: [assetId], references: [id])

  @@unique([watchlistId, assetId])
  @@index([watchlistId])
}
